@model ComputerStore.Web.Models.CreateReviewViewModel

@{
    ViewData["Title"] = "Написать отзыв";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow">
                <div class="card-header bg-warning">
                    <h4 class="mb-0">
                        <i class="bi bi-star-fill"></i> Написать отзыв
                    </h4>
                </div>
                <div class="card-body">

                    <!-- Информация о товаре -->
                    <div class="d-flex align-items-center mb-4 pb-4 border-bottom">
                        @if (!string.IsNullOrEmpty(Model.ProductImageUrl))
                        {
                            <img src="@Model.ProductImageUrl" alt="@Model.ProductName"
                                 style="width: 80px; height: 80px; object-fit: contain;" class="me-3" />
                        }
                        <div>
                            <h5 class="mb-1">@Model.ProductName</h5>
                            @if (!string.IsNullOrEmpty(Model.OrderNumber))
                            {
                                <small class="text-muted">
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    Подтверждённая покупка (Заказ #@Model.OrderNumber)
                                </small>
                            }
                        </div>
                    </div>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ProductId" value="@Model.ProductId" />
                        <input type="hidden" name="OrderId" value="@Model.OrderId" />

                        <!-- Рейтинг -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Оценка *</label>
                            <div class="star-rating-input">
                                <div class="stars" id="star-rating">
                                    <input type="radio" name="Rating" value="5" id="star5" required />
                                    <label for="star5" title="5 звёзд">&#9733;</label>
                                    <input type="radio" name="Rating" value="4" id="star4" />
                                    <label for="star4" title="4 звезды">&#9733;</label>
                                    <input type="radio" name="Rating" value="3" id="star3" />
                                    <label for="star3" title="3 звезды">&#9733;</label>
                                    <input type="radio" name="Rating" value="2" id="star2" />
                                    <label for="star2" title="2 звезды">&#9733;</label>
                                    <input type="radio" name="Rating" value="1" id="star1" />
                                    <label for="star1" title="1 звезда">&#9733;</label>
                                </div>
                                <div class="rating-text mt-2" id="rating-text">
                                    <small class="text-muted">Выберите оценку</small>
                                </div>
                            </div>
                        </div>

                        <!-- Заголовок -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Заголовок отзыва *</label>
                            <input asp-for="Title" class="form-control"
                                   placeholder="Кратко опишите впечатление от товара"
                                   maxlength="200" required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                            <small class="text-muted">Осталось символов: 200</small>
                        </div>

                        <!-- Текст отзыва -->
                        <div class="mb-4">
                            <label asp-for="Comment" class="form-label fw-bold">Текст отзыва *</label>
                            <textarea asp-for="Comment" class="form-control" rows="6"
                                      placeholder="Расскажите подробнее: что понравилось, что нет, кому подойдёт товар..."
                                      maxlength="2000" required></textarea>
                            <span asp-validation-for="Comment" class="text-danger"></span>
                            <small class="text-muted">Осталось символов: 2000</small>
                        </div>

                        <!-- Рекомендации -->
                        <div class="alert alert-info">
                            <h6><i class="bi bi-info-circle"></i> Правила написания отзывов:</h6>
                            <ul class="mb-0 small">
                                <li>Пишите только о данном товаре</li>
                                <li>Описывайте реальный опыт использования</li>
                                <li>Не указывайте личные данные</li>
                                <li>Отзыв будет опубликован после проверки модератором</li>
                            </ul>
                        </div>

                        <!-- Кнопки -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="bi bi-send-fill"></i> Отправить отзыв
                            </button>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Отмена
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .star-rating-input { text-align: center; }
    .stars { display: inline-flex; flex-direction: row-reverse; justify-content: center; }
    .stars input[type="radio"] { display: none; }
    .stars label { font-size: 3rem; color: #ddd; cursor: pointer; transition: color 0.2s; margin: 0 5px; }
    .stars input[type="radio"]:checked ~ label,
    .stars label:hover,
    .stars label:hover ~ label { color: #ffc107; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const ratingInputs = document.querySelectorAll('input[name="Rating"]');
        const ratingText = document.getElementById('rating-text');
        const ratingTexts = {
            5: '<strong class="text-warning">&#9733;&#9733;&#9733;&#9733;&#9733;</strong> Отлично',
            4: '<strong class="text-warning">&#9733;&#9733;&#9733;&#9733;</strong> Хорошо',
            3: '<strong class="text-warning">&#9733;&#9733;&#9733;</strong> Нормально',
            2: '<strong class="text-warning">&#9733;&#9733;</strong> Плохо',
            1: '<strong class="text-warning">&#9733;</strong> Ужасно'
        };
        ratingInputs.forEach(input => {
            input.addEventListener('change', function () {
                ratingText.innerHTML = ratingTexts[this.value];
            });
        });

        const titleInput = document.querySelector('input[name="Title"]');
        const commentInput = document.querySelector('textarea[name="Comment"]');
        if (titleInput) {
            titleInput.addEventListener('input', function () {
                const remaining = 200 - this.value.length;
                this.nextElementSibling.nextElementSibling.textContent = `Осталось символов: ${remaining}`;
            });
        }
        if (commentInput) {
            commentInput.addEventListener('input', function () {
                const remaining = 2000 - this.value.length;
                this.nextElementSibling.nextElementSibling.textContent = `Осталось символов: ${remaining}`;
            });
        }
    </script>
}